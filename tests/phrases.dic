ah, tch'est qu'tu nouos prêche là -> a tʃ_e k_t_y n_w_o p_r_ei_ʃ l_a_
ah, tchi bouon dêbarras -> a tʃ_i b_w_õ d_ei_b_a_r_a_
ah, tchi bouôn dêbarras -> a tʃ_i b_w_õ d_ei_b_a_r_a_
ah, tchi cliavette — sécours dé la vie -> a tʃ_i k_j_a_v_ɛ_t s_ɛ_k_u_r d_ɛ l_a v_iː_
ah, tchil enchantement - tchi bouonnes nouvelles -> a tʃ_i_l ɑ̃_ʃ_ɑ̃_t_m tʃ_i b_w_ɔ_n n_u_v_ɛ_l_
ah, tchille odeu - i' couochait -> a tʃ_i_j ɔ_d_œ i k_w_ɔ_ʃ_ei_
ah, tchi pêque-mêle -> a tʃ_i p_ei_k m_ei_l_
ah, tchi pouôrre mathette, chette-là -> a tʃ_i p_w_ou_r m_a_ð_ɛ_t ʃ_ɛ_t l_a_
