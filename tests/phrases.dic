ah, ou n'n'a fait ses chours y'a longtemps -> a u n_n_a f_ei s_ɛ ʃ_u_r j_a l_õ_ɡ_t_ɑ̃_
ah, ou r'est horte à vresser -> a u r_e h_ɔ_r_t a v_r_ɛ_s_e_
ah, pouor ch'la, i' fait san travas en conscienche -> a p_w_ɔ_r ʃ_l_a i f_ei s_ɑ̃ t_r_a_v_a ɑ̃ k_õ_s_j_ɑ̃_ʃ_
ah, pouôrre innocent -> a p_w_ou_r ɪ_n_ɔ_s_ɑ̃_
ah, pouôrre lantèrne -> a p_w_ou_r l_ɑ̃_t_ɛ_r_n_
ah, pouôrreté -> a p_w_ou_r_ɛ_t_ɛ_
ah, quand i' s'y'avole, ou viyiz, i' peut travailli -> a k_ɑ̃ i s_j_a_v_ɔ_l u v_i_j_i i p_œ t_r_a_v_ɑː_j_i_
ah, quand i' s'y'êcante, ou viyiz, i' peut travailli -> a k_ɑ̃ i s_j_ei_k_ɑ̃_t u v_i_j_i i p_œ t_r_a_v_ɑː_j_i_
ah, rein n'est au natuthé achteu, nou-s-acate tout en boêtes dé blianc-fé -> a r_ɛ̃ n_e ou n_a_t_y_ð_ɛ a_ʃ_t_œ n_u_z a_k_a_t t_u ɑ̃ b_ɔ_ei_t d_ɛ b_j_ɑ̃ f_ɛ_
ah, rein n'est au natuthé à ch't heu, nou-s-acate tout en boêtes dé blianc-fé -> a r_ɛ̃ n_e ou n_a_t_y_ð_ɛ a ʃ_t œ n_u_z a_k_a_t t_u ɑ̃ b_ɔ_ei_t d_ɛ b_j_ɑ̃ f_ɛ_
ah, sâcré gris ventre - ventre à pouaîsse -> a s_ɑː_k_r_ɛ ɡ_r_iː v_ɑ̃_t_r v_ɑ̃_t_r a p_w_ei_s_
ah, saladgi - si j'l'attrape -> a s_a_l_a_dʒ_i s_i ʒ_l_a_t_r_a_p_
ah, saquétîn -> a s_a_k_ɛ_t_ẽ_
ah, sécours - a-t-i' fallu combattre pouor y'arriver -> a s_ɛ_k_u_r a_t_i f_a_l_y k_õ_b_a_t_r p_w_ɔ_r j_a_r_i_v_e_
ah, sécours des cieux -> a s_ɛ_k_u_r d_e s_j_œː_
ah, sécours, j'n'ai ouï qu'vitupelles tout l'long du c'mîn -> a s_ɛ_k_u_r ʒ_n_e w_i k_v_i_t_y_p_ɛ_l t_u l_l_õ d_y k_m_ẽ_
ah, sécours, j'n'ai ouï qu'vitupéthes tout l'long du c'mîn -> a s_ɛ_k_u_r ʒ_n_e w_i k_v_i_t_y_p_ɛ_ð t_u l_l_õ d_y k_m_ẽ_
ah, sécours, j't'en prie -> a s_ɛ_k_u_r ʒ_t_ɑ̃ p_r_iː_
ah, sécours -> a s_ɛ_k_u_r_
ah, sécours — tchi bayayas -> a s_ɛ_k_u_r tʃ_i b_a_j_a_j_a_
ah, sécours, tchi conmédie -> a s_ɛ_k_u_r tʃ_i k_õ_m_ɛ_d_iː_
ah, sécours, tchi gouâl'lie -> a s_ɛ_k_u_r tʃ_i ɡ_w_ɑː_l_l_iː_
ah, sécours, tchil êmoué -> a s_ɛ_k_u_r tʃ_i_l ei_m_w_ɛ_
ah, sécours, tchil enfouônneux - vaut mus l'chèrgi qué d'l'emplyi -> a s_ɛ_k_u_r tʃ_i_l ɑ̃_f_w_õ_n_œː v_ou m_y l_ʃ_ɛ_r_ʒ_i k_ɛ d_l_ɑ̃_p_j_i_
ah, sécours, tchille ânionn'nie - j'm'en vais t'envyer au liet s'tu continnue -> a s_ɛ_k_u_r tʃ_i_j ɑː_n_j_ɔ_n_n_iː ʒ_m_ɑ̃ v_e t_ɑ̃_v_j_e ou j_ɛ s_t_y k_õ_t_ɪ_n_yː_
ah, sécours — tchille olympe -> a s_ɛ_k_u_r tʃ_i_j ɔ_l_i_m_p_
