externals ( phonemize separator )

routines (
  phonemize_word
  phonemize_word_with_hyphens
  phoneme
  word_end
  test_liaison
)

get 'src/stringdefs.sbl'
get 'src/liaison.sbl'
get 'src/silent_nt.sbl'
get 'src/silent_h.sbl'
get 'src/phonemes.sbl'
get 'src/special-case.sbl'

define phoneme as ( 
  word_final
  or mid_word_exceptions
  or vowel_phoneme
  or consonant_phoneme
)

define phonemize_word as (
  single_letter
  or (
    repeat (exceptions or pre_word)
    silent_nt
    try word_initial
    repeat phoneme
  )
)

define phonemize_word_with_hyphens as (
  exceptions_with_hyphens
  or repeat (
    setlimit ((goto '-') or tolimit) for phonemize_word
    goto ['-'] <- ' '
  )
)

define word_end as (
  (goto ' ') or tolimit
)

define test_liaison as (
  unset may_liaise
  do (
    ' '
    vowels or setlimit word_end for silent_h
    set may_liaise
  )
)

define separator as ( [ tolimit ] -> sep )

define phonemize as (
  // Default separator
  do $sep ($(len == 0) = '|')  

  // Remove unknown characters
  do repeat (goto (not accepted_characters) [ next ] <- ' ')

  // Remove multiple spaces
  do repeat (gopast ' ' [ goto not (' ' or '-') ] delete)

  // Loop through words
  repeat (
    try liaison_set_phrases
    setlimit (word_end test_liaison) for phonemize_word_with_hyphens
    gopast ' '
  )
)
