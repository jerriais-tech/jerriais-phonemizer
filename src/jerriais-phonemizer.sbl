externals ( phonemize )

routines (
  exceptions
  phoneme
  consonant_phoneme
  vowel_phoneme
  silent_h
  silent_l
  word_initial
  word_final
)

groupings (
  vowels 
  consonants 
  e_any 
  i_any 
  y_any 
  hard_vowels 
  soft_vowels
  vowels_without_y
)

booleans ( after_vowel )

stringescapes {}

/* special characters */

stringdef a^   '{U+00E2}'  // a-circumflex
stringdef a`   '{U+00E0}'  // a-grave
stringdef cc   '{U+00E7}'  // c-cedilla

stringdef e"   '{U+00EB}'  // e-diaeresis (rare)
stringdef e'   '{U+00E9}'  // e-acute
stringdef e^   '{U+00EA}'  // e-circumflex
stringdef e`   '{U+00E8}'  // e-grave
stringdef i"   '{U+00EF}'  // i-diaeresis
stringdef i^   '{U+00EE}'  // i-circumflex
stringdef o^   '{U+00F4}'  // o-circumflex
stringdef o"   '{U+00F6}'  // o-diaresis (rare)
stringdef u^   '{U+00FB}'  // u-circumflex
stringdef u`   '{U+00F9}'  // u-grave
stringdef y^   '{U+0177}'  // y-grave


stringdef esh   '{U+0283}'  // ʃ
stringdef ezh   '{U+0292}'  // ʒ
stringdef ich   '{U+00E7}'  // ç
stringdef eth   '{U+00F0}'  // ð
stringdef ngn   '{U+0272}'  // ɲ

stringdef scripta '{U+0251}'  // ɑ
stringdef eps     '{U+025B}'  // ɛ
stringdef openo   '{U+0254}'  // ɔ
stringdef oe      '{U+0153}'  // œ
stringdef o`      '{U+00F8}'  // ø

stringdef tilde     '{U+0303}'          // combining ~
stringdef a~        '{U+00E3}'          // ã
stringdef e~        '{U+1EBD}'          // ẽ
stringdef o~        '{U+00F5}'          // õ
stringdef scripta~  '{scripta}{tilde}'  // ɑ̃
stringdef openo~    '{openo}{tilde}'    // ɔ̃
stringdef eps~      '{eps}{tilde}'      // ɛ̃
stringdef o`~       '{o`}{tilde}'       // ø̃

stringdef long  '{U+02D0}'  // ː

define e_any 'e{e"}{e'}{e^}{e`}'
define i_any 'i{i"}{i^}'
define y_any 'y{y^}'

define soft_vowels e_any + i_any + y_any
define hard_vowels 'a{a^}{a`}o{o^}u{u^}{u`}'

define vowels hard_vowels + soft_vowels

define vowels_without_y vowels - y_any

define consonants 'bc{cc}dfghjklmnpqrstvwxz'

define exceptions as (
  [substring] among (
    'mille' (<- 'mil')
    'ville' (<- 'vil')
    'sept' (<- 's{eps}t')
    'corps' (<- 'k{openo}r')
    'temps' (<- 't{a~}')
    'th{e'}e' (<- 'tei')
    'j{e'}tho' (<- 'j{eps}t{openo}')
    'eus' 'eut' (<- 'u')
    'e{u^}nmes' (<- 'u{long}m')
    'e{u^}tes' 'e{u^}tent' (<- 'u{long}t')
    'e{u^}dres' 'e{u^}drent' (<- 'u{long}dr')
    // TODO: eûsse etc
    // etions
  )
)

// TODO: Liasons

define word_initial as (
  silent_h
  or ([ 'l' ('y' or 'i') ] test vowels <- 'j' set after_vowel)
)

define silent_h as (
  test substring 
  among (
    'histouaithe'
    'heuthe'
    'he{u^}theux'
    // TODO: fill in list
    (['h'] delete)
  )
)

define silent_l as (
  // l after certain consonants
  (
   test (('f' or 'g' or 'c' or 'b' or 'p') 'l' (y_any or i_any))
   consonant_phoneme [ 'l' (y_any or i_any) ] ((test y_any <- 'ji') or <- 'j')
  )
  // l'ye after consonant
  or (
    test (consonants 'l{'}ye') consonant_phoneme [ 'l{'}ye' ] <- 'j'
  )
)

define consonant_phoneme as (
    [substring] among (
      'b' 'bb' (<- 'b')
      '{cc}' (<- 's')
      'c' ((test soft_vowels <- 's') or <- 'k')
      'cc' ((test soft_vowels <- 'ks') or <- 'k')
      'c{'}c' (<- 'ss')
      'ch' (<- '{esh}')
      'ch{'}ch' (<- '{esh}{esh}')
      'd' 'dd' (<- 'd')
      'd{'}d' (<- 'dd')
      'dg' (<- 'd{ezh}')
      'f' 'ff' (<- 'f')
      'g' (
        (
          test soft_vowels
          <- '{ezh}'
          // Delete following e if it only exists to soften hard vowel
          try (
            ['e']
            test ('o' or '{o^}' or 'a' or '{a^}')
            delete
          )
        )
        or <- 'g'
      )
      'g{'}g' (<- '{ezh}{ezh}')
      'h' ()
      'j' (<- '{ezh}')
      'k' ()
      'l' 'll' 'l{'}ye' (<- 'l')
      'l{'}l' (<- 'll')
      'lyi' (<- 'ji')
      'm' 'mm' (<- 'm')
      'n' 'nn' (<- 'n')
      'gn' (<- '{ngn}')
      'n{'}n' (<- 'nn')
      'p' 'pp' (<- 'p')
      'qu' 'cqu' (<- 'k')
      'r' 'rr' (<- 'r')
      'rr{'}r' (<- 'rr')
      's' 'ss' (<- 's')
      'sc' ((test soft_vowels <- 's') or <- 'sk')
      's{'}s' (<- 'ss')
      't' 'tt' (<- 't')
      't{'}t' (<- 'tt')
      'tch' (<- 't{esh}')
      'th' (<- '{eth}')
      'th{'}th' (<- '{eth}{eth}')
      'v' ()
      'w' ()
      'x' (<- 'z')
      'y' (<- 'j')
      'z' (<- 'z')
      '{'}' '-' (delete)
      ' ' ()
      // ending in consonants
      'aill{'}' (<- '{scripta}l')
      '{e`}rr' (<- '{eps}{long}r')
      'onn' (<- 'on')
      'onnem' (<- 'onm')
      'omm' (<- 'om')
      'aine' 'eine' (<- '{eps}n')
      'ainem' 'einem' (<- '{eps}nm')
    )
    unset after_vowel
)

define vowel_phoneme as (
  [substring] among (
    'oeu' (<- '{oe}')
    'ueu' (<- 'w{oe}')
    'a' '{a`}' (/* Check this (test 'bl' <- '{scripta}') or */ <- 'a')
    '{a^}' (<- '{scripta}{long}')
    'ai' 'a{i^}' (<- 'ei')
    'au' 'a{u^}' (<- 'ou')
    'an' 'en' '{e"}n' (<- '{scripta~}')
    'ann' (<- 'an')
    'angn' (<- 'a{ngn}')
    'ain' 'ein' ((test vowels <- '{eps}n') or <- '{eps~}')
    'aill' (<- '{scripta}{long}j')
    'aill{'}l' (<- '{scripta}{long}jj')
    'e' '{e'}' '{e`}' 'ei' (<- '{eps}')
    '{e^}' (<- 'ei')
    '{e'}e' '{e'}es' (<- 'e')
    'e{i^}' (<- '{eps}{long}')
    'eu' (<- '{oe}')
    'e{u^}' (<- '{oe}{long}')
    'eau' (<- 'ou')
    'enn' (<- '{eps}n')
    'eill' (<- 'ej')
    'i' '{i"}' 'y' ((not after_vowel test vowels_without_y <- 'j') or <- 'i')
    '{i^}' '{y^}' (<- 'i{long}')
    'in' '{i^}n' (<- '{e~}')
    'ill' (<- 'j')
    'o' (<- '{openo}')
    '{o^}' (<- 'ou')
    'ou' '{o"}u' ((not after_vowel test vowels <- 'w') or <- 'u')
    'o{u^}' (<- 'u{long}')
    'on' 'om' (<- '{o~}')
    '{o^}n' '{o^}m' (<- '{o~}')
    'u' '{u`}' (<- 'y')
    '{u^}' (<- 'y{long}')
    'ui' (<- 'ui')
    'u{i^}' (<- 'ui{long}')
    'u{i^}n' (<- 'u{e~}')
    'un' 'um' (<- '{o`~}')
    'unn' (<- 'un')
    'umm' (<- 'um')
    'yi' (<- 'ji')
    // ending in vowels
    'tion' (<- 'sj{o~}')
  )
  set after_vowel
  // intervocalic s
  try (['s'] test vowels <- 'z' unset after_vowel)
)

define word_final as (
    test (
      [substring] 
      not next 
    )
    among (
      'ai' 'ais'
      (<- 'e')
      'et' 'ets'
      (<- '{eps}')
      'er'
      (<- 'e')
      'a{i^}' 'a{i^}s'
      (<- '{eps}{long}')
      'au' 'aus'
      (<- 'ou')
      'aue' 'aues'
      'aux'
      'eaux'
      (<- 'ou{long}')
      'ieau'
      (<- 'jou')
      'ieaux'
      (<- 'jou{long}')
      'eux'
      (<- '{oe}{long}')
      'euse'
      (<- '{oe}{long}z')
      'ait'
      'aient'
      'aie' 'aies'
      (<- 'ei')
      '{e'}s'
      'ez'
      (<- 'e')
      'o'
      'os'
      (<- 'o')
      'oue'
      (<- 'u{long}')
      'ien'
      ((not after_vowel test vowels_without_y <- 'y{eps}~') <- 'i{eps~}')
      'inne' 'innes'
      (<- 'In')
      'it'
      'id'
      (<- 'i')
      'ue'
      (<- 'y{long}')
      'ie' 'is' 'iz' 'ix' 'its' 'ids' (<- 'i{long}')
      'eue' 'eues' (<- '{oe}{long}')
      'ye' 'yes' (<- 'i')
      'e' 'es' (delete)
      // TODO: plural of silent final vowel
      'b' 'c' 'd' 'g' 'h' 'j' 'k' 'm' 'n' 'p' 's' 't' 'v' 'w' 'x' 'y' 'z' (delete)
    )
    tolimit
)

define phoneme as ( 
    word_final
    or silent_l
    or consonant_phoneme
    or vowel_phoneme
  )

define phonemize as (
    unset after_vowel
    exceptions 
    or try word_initial repeat phoneme
)
