externals ( phonemize )

get 'src/stringdefs.sbl'
get 'src/silent_nt.sbl'
get 'src/silent_h.sbl'

routines (
  exceptions
  phoneme
  consonant_phoneme
  vowel_phoneme
  silent_l
  pre_word
  word_initial
  word_final
  mid_word_exceptions
  delete_soft_e
)

define pre_word as (
  [substring]
  among (
    'j{'}' (<- '{ezh}')
    't{'}' (<- '{t}')
    's{'}' (<- '{s}')
    'l{'}' (<- '{l}')
    'li{'}' (<- '{l}{i}')
    'd{'}' (<- '{d}')
    'm{'}' (<- '{m}')
    'n{'}' (<- '{n}')
    'qu{'}' (<- '{k}')
  )
)

define exceptions as (
  (
    [substring]
    atlimit
    among (
      'les' (<- '{l}{e}')
      'hie' (<- '{i}{long}')
      'guy' (<- '{g}{y}')
    )
  )
  or
  (
    [substring] 
    among (
      'ville' (<- '{v}{i}{l}')
      'mille' (<- '{m}{i}{l}')
      'biblioth{e`}que' (<- '{b}{i}{b}{j}{openo}{t}{eps}{k}')
      'hypoth{e`}que' (<- '{i}{p}{openo}{t}{eps}{k}')
      'sept' (<- '{s}{eps}{t}')
      'corps' (<- '{k}{openo}{r}')
      'j{e'}tho' (<- '{j}{eps}{t}{openo}')
      'eus' 'eut' (<- '{y}')
      'e{u^}nmes' (<- '{y}{long}{m}')
      'e{u^}tes' 'e{u^}tent' (<- '{y}{long}{t}')
      'e{u^}dres' 'e{u^}drent' (<- '{y}{long}{d}{r}')
      'guy' (<- '{g}{y}{j}')
      'biguesse' (<- '{b}{i}{g}{eps}{s}')
      'onguenn' (<- '{o~}{g}{scripta~}{n}')
      'onguent' (<- '{o~}{g}{scripta~}')
      // TODO: eûsse etc
      // etions
    )
  )
)

// TODO: Liasons

define word_initial as (
  try silent_h
  ([ 'th' ] <- '{t}')
  or ([ try 'l' ('y' or 'i') ] test vowels <- '{j}')
  or (['tu{'}'] test vowels <- '{t}{w}')
  or ([('ex' or 'x-') try ('c' test soft_vowels)] <- '{eps}{k}{s}')
)

define silent_l as (
  // l after certain consonants
  (
    test (substring among('f' 'ff' 'g' 'c' 'cc' 'b' 'bb' 'p' 'pp' ('l' y_any or i_any)))
    consonant_phoneme 
    ([ 'l' y_any try i_any ] <- '{j}{i}') or ([ 'l' i_any ] <- '{j}')
  )
  // l'ye after consonant
  or (
    test (consonants 'l{'}ye') consonant_phoneme [ 'l{'}ye' ] <- '{j}'
  )
  // treat as word initial following an apostrophe
  or ( [ '{'}l' ('y' or 'i') ] test vowels <- '{j}')
)

define mid_word_exceptions as (
  silent_l
  or (
    [substring] among (
      'temps' (<- '{t}{a~}')
      'llem' (<- '{l}{m}')
      'aill{'}' (<- '{scripta}{l}')
      '{e`}rr' (<- '{eps}{long}{r}')
      'tion' (<- '{s}{j}{o~}')
    )
  )
)

define delete_soft_e as (
    try (
      ['e']
      test ('o' or '{o^}' or 'a' or '{a^}')
      delete
    )
)

define consonant_phoneme as (
    [substring] among (
      'b' 'bb' (<- '{b}')
      '{cc}' (<- '{s}')
      'c' ((test soft_vowels <- '{s}' delete_soft_e) or <- '{k}')
      'cc' ((test soft_vowels <- '{k}{s}' delete_soft_e) or <- '{k}')
      'c{'}c' (<- '{s}{s}')
      'ce{'}' (<- '{s}')
      'ch' (<- '{esh}')
      'ch{'}ch' (<- '{esh}{esh}')
      'chr' (<- '{k}{r}')
      'd' 'dd' (<- '{d}')
      'd{'}d' (<- '{d}{d}')
      'dg' (<- '{d}{ezh}')
      'f' 'ff' (<- '{f}')
      'g' ((test (soft_vowels or '{'}') <- '{ezh}' delete_soft_e) or <- '{g}')
      'gu' ((test (soft_vowels or '{'}') <- '{g}') or <- '{g}{y}')
      'gue' (<- '{g}')
      'h' ()
      'j' (<- '{ezh}')
      'k' ()
      'l' 'll' 'l{'}ye' (<- '{l}')
      'l{'}l' (<- '{l}{l}')
      'lyi' (<- '{j}{i}')
      'm' 'mm' (<- '{m}')
      'n' 'nn' (<- '{n}')
      'gn' (<- '{gn}')
      'n{'}n' (<- '{n}{n}')
      'p' 'pp' (<- '{p}')
      'qu' 'cqu' (<- '{k}')
      'r' 'rr' (<- '{r}')
      'rr{'}r' (<- '{r}{r}')
      's' ((reverse ('s' try '{long}' ipa_oral_vowels) test vowels <- '{z}') or <- '{s}')
      'ss' (<- '{s}')
      'sc' ((test soft_vowels <- '{s}') or <- '{s}{k}')
      's{'}s' (<- '{s}{s}')
      't' 'tt' (<- '{t}')
      't{'}t' (<- '{t}{t}')
      'tch' (<- '{t}{esh}')
      'th' (<- '{eth}')
      'th{'}th' (<- '{eth}{eth}')
      'v' ()
      'w' ()
      'x' (<- '{z}')
      'z' (<- '{z}')
      '{'}' (delete)
      ' ' ()
      '-' (<- ' ')
    )
)

define vowel_phoneme as (
  [substring] among (
    'a' '{a`}' (<- '{a}')
    '{a^}' (<- '{scripta}{long}')
    'ai' 'a{i^}' (<- '{e}{i}')
    'au' 'a{u^}' (<- '{o}{u}')
    'en' '{e"}n' 'em' '{e"}m' (<- '{scripta~}')
    'an' ((test vowels <- 'an') or <- '{scripta~}')
    'ann' (<- '{scripta}{n}')
    'ain' 'ein' ((test vowels <- '{eps}{n}') or <- '{eps~}')
    'aill' (<- '{scripta}{long}{j}')
    'aill{'}l' (<- '{scripta}{long}{j}{j}')
    'ayi' (<- '{e}{long}{j}{i}')
    'e' '{e'}' '{e`}' 'ei' (<- '{eps}')
    '{e^}' (<- '{e}{i}')
    '{e'}e' '{e'}es' (<- '{e}')
    'e{i^}' (<- '{eps}{long}')
    'eu' (<- '{oe}')
    'e{u^}' (<- '{oe}{long}')
    'eau' (<- '{o}{u}')
    'enn' 'enne' (<- '{eps}{n}')
    'eill' (<- '{e}{j}')
    'eill{'}l' (<- '{e}{long}{j}{j}')
    '{i"}' 'y' ((test vowels_without_y <- '{j}') or <- '{i}')
    '{i^}' '{y^}' (<- '{i}{long}')
    'in' '{i^}n' (<- '{e~}')
    'inn' (
      <- '{I}{n}'
      test try (
        [ 'e' ]
        ('m' or 'p' or ('t' e_any))
        delete
      )
    )
    'o' (<- '{openo}')
    '{o^}' (<- '{o}{u}')
    '{o"}u' ((test vowels <- '{w}') or <- '{u}')
    'o{u^}' (<- '{u}{long}')
    'oeu' (<- '{oe}')
    '{o^}n' (<- '{o~}')
    'on' ((test vowels <- '{openo}{n}') or <- '{o~}')
    'om' ((test vowels <- '{openo}{m}') or <- '{o~}')
    'onn' (<- '{o}{n}')
    'onnem' (<- '{o}{n}{m}')
    'omm' (<- '{o}{m}')
    'aine' 'eine' 'ainne' 'einne' (<- '{eps}{n}')
    'ainem' 'einem' (<- '{eps}{n}{m}')
    'ent' 'ant' (
      (
        test (vowels or 'ch' or 'r')
        <- '{scripta~}{t}'
        test try (
          [ 'e' ]
          ('m' or 'p')
          delete
        )
      ) 
      or <- '{scripta~}'
    )
    'u' '{u`}' (<- '{y}')
    '{u^}' (<- '{y}{long}')
    'ueu' (<- '{w}{oe}')
    'ui' (<- '{u}{i}')
    'u{i^}' (<- '{u}{i}{long}')
    'u{i^}n' (<- '{u}{e~}')
    'un' 'um' (<- '{o`~}')
    'unn' (<- '{u}{n}')
    'umm' (<- '{u}{m}')
    'yi' (<- '{j}{i}')
    'i' ((reverse ('i' ipa_consonants) test vowels_without_y <- '{j}') or <- '{i}')
    'ou' (
      (
        reverse (
          'ou' 
          (ipa_consonants or (try '{long}' ipa_nasal_vowels) or atlimit)
        ) 
        test vowels 
        <- '{w}'
      )
      or <- '{u}'
    )
    'ill' ((reverse ('ill' try '{long}' ipa_vowels)  <- '{j}') or <- '{i}{j}')
    'ill{'}l' ((reverse ('ill{'}' try '{long}' ipa_vowels)  <- '{j}{j}') or <- '{i}{j}{j}')
  )
)

define word_final as (
    [substring] 
    // Remove this when multi-word is implemented
    (atlimit or test '-')
    among (
      '-t-i{'}' (<- ' {t}{i}')
      'ai' 'ais' 'er'
        (<- '{e}')
      'aim'
        (<- '{eps~}')
      'aye'
        (<- '{e}{i}')
      'et' 'ets'
        (<- '{eps}')
      'a{i^}' 'a{i^}s'
        (<- '{eps}{long}')
      'au' 'aus'
        (<- '{o}{u}')
      'aue'
      'aues'
      'aux'
      'eaux'
        (<- '{o}{u}{long}')
      'ieau'
        (<- '{j}{o}{u}')
      'ieaux'
        (<- '{j}{o}{u}{long}')
      'eux'
        (<- '{oe}{long}')
      'euse'
        (<- '{oe}{long}{z}')
      'ait'
      'aient'
      'aie'
      'aies'
        (<- '{e}{i}')
      'eyen'
      'a{i"}en'
        (<- '{e}{i}{eps~}')
      '{e'}s'
      'ez'
        (<- '{e}')
      '{e'}er'
        (<- '{e}{i}{e}')
      'o'
      'os'
        (<- '{o}')
      'oue'
        (<- '{u}{long}')
      '-ous'
        (<- '{u}')
      'ien'
      '{i"}en'
        (
          (
            reverse (('ien' or '{i"}en') ipa_consonants)
            <- '{y}{eps~}'
          )
          or <- '{i}{eps~}'
        )
      'inne'
      'innes'
        (<- '{I}{n}')
      'it'
      'id'
        (<- '{i}')
      'ue'
        (<- '{y}{long}')
      'ie'
      'ies'
      'is'
      'iz'
      'ix'
      'its'
      'ids'
        (<- '{i}{long}')
      'eue'
      'eues'
        (<- '{oe}{long}')
      'ye'
      'yes'
        (<- '{i}')
      'e'
      'es'
      (delete)
      'gue'
      'gues'
        (<- '{g}')
      'enner'
      'ennez'
        (<- '{eps}{n}{e}')
      'ment'
      'ments'
      'ement'
      'ements'
        (<- '{m}{scripta~}')
      'mente'
      'mentes'
      'emente'
      'ementes'
        (<- '{m}{scripta~}t')
      'ville'
      'villes'
        (<- '{v}{i}{l}')
      'b' 'c' 'd' 'g' 'h' 'j' 'k' 'm' 'n' 'p' 's' 't' 'v' 'w' 'x' 'y' 'z'
        (delete)
    )
)

define phoneme as ( 
    word_final
    or mid_word_exceptions
    or vowel_phoneme
    or consonant_phoneme
  )

// TODO: multi word

define phonemize as (
    repeat pre_word
    exceptions 
    or 
    silent_nt
    try word_initial
    repeat phoneme
)
