externals ( phonemize )

get 'src/stringdefs.sbl'
get 'src/silent_nt.sbl'
get 'src/silent_h.sbl'

routines (
  phonemize_word
  phonemize_word_with_hyphens
  exceptions_with_hyphens
  exceptions
  phoneme
  consonant_phoneme
  vowel_phoneme
  silent_l
  pre_word
  word_initial
  word_final
  mid_word_exceptions
  delete_soft_e
  test_atlimit
  oralize
)

define test_atlimit as atlimit
define oralize as ( test (vowels or '{'}') )

define pre_word as (
  [substring]
  among (
    'j{'}' (<- '{ezh}')
    't{'}' (<- '{t}')
    's{'}' (<- '{s}')
    'l{'}' (<- '{l}')
    'li{'}' (<- '{l}{i}')
    'd{'}' (<- '{d}')
    'm{'}' (<- '{m}')
    'n{'}' (<- '{n}')
    'qu{'}' (<- '{k}')
    'tu{'}' ((test ('ou' vowels) <- '{t}') or <- '{t}{w}')
    'ch{'}' (<- '{esh}')
  )
)

define exceptions as (
  [substring] 
  among (
    // TODO: individual letters
    'x' test_atlimit (<- '{eps}{k}{s}')
    'les' test_atlimit (<- '{l}{e}')
    'des' test_atlimit (<- '{d}{e}')
    'en' test_atlimit 'en{'}' (<- '{scripta~}')
    'hie' test_atlimit (<- '{i}{long}')
    'guy' ((atlimit <- '{g}{y}') or <- '{g}{y}{j}')
    'v{i^}ngt' ((atlimit <- '{v}{e~}') or <- '{v}{e~}t')
    'v{i^}ngts' (<- '{v}{e~}')
    'ville' (<- '{v}{i}{l}')
    'mille' (<- '{m}{i}{l}')
    'biblioth{e`}que' (<- '{b}{i}{b}{j}{openo}{t}{eps}{k}')
    'hypoth{e`}que' (<- '{i}{p}{openo}{t}{eps}{k}')
    'sept' (<- '{s}{eps}{t}')
    'corps' (<- '{k}{openo}{r}')
    'j{e'}tho' (<- '{j}{eps}{t}{openo}')
    'eus' 'eut' test_atlimit (<- '{y}')
    'e{u^}nmes' (<- '{y}{long}{m}')
    'e{u^}tes' 'e{u^}tent' (<- '{y}{long}{t}')
    'e{u^}dres' 'e{u^}drent' (<- '{y}{long}{d}{r}')
    'biguesse' (<- '{b}{i}{g}{eps}{s}')
    'onguenn' (<- '{o~}{g}{scripta~}{n}')
    'onguent' (<- '{o~}{g}{scripta~}')
    // TODO: eûsse etc
    // etions
  )
)

// TODO: Liasons

define word_initial as (
  try silent_h
  ([ 'th' ] <- '{t}')
  or ([ try 'l' ('y' or 'i') ] test vowels <- '{j}')
  or ([('ex' or 'x-') try ('c' test soft_vowels)] <- '{eps}{k}{s}')
)

define silent_l as (
  // l after certain consonants
  (
    test (substring among('f' 'ff' 'g' 'c' 'cc' 'b' 'bb' 'p' 'pp' ('l' y_any or i_any)))
    consonant_phoneme 
    ([ 'l' y_any try i_any ] <- '{j}{i}') or ([ 'l' i_any ] <- '{j}')
  )
  // l'ye after consonant
  or (
    test (consonants 'l{'}ye') consonant_phoneme [ 'l{'}ye' ] <- '{j}'
  )
  // treat as word initial following an apostrophe
  or ( [ '{'}l' ('y' or 'i') ] test vowels <- '{j}')
)

define mid_word_exceptions as (
  silent_l
  or (
    [substring] among (
      'temps' (<- '{t}{a~}')
      'femm' (<- '{f}{scripta~}{m}')
      'llem' (<- '{l}{m}')
      '{e`}rr' (<- '{eps}{long}{r}')
      'tion' (<- '{s}{j}{o~}')
    )
  )
)

define delete_soft_e as (
    try (
      ['e']
      test ('o' or '{o^}' or 'a' or '{a^}')
      delete
    )
)

define consonant_phoneme as (
    [substring] among (
      'b' 'bb' (<- '{b}')
      '{cc}' (<- '{s}')
      'c' ((test soft_vowels <- '{s}' delete_soft_e) or <- '{k}')
      'cc' ((test soft_vowels <- '{k}{s}' delete_soft_e) or <- '{k}')
      'c{'}c' (<- '{s}{s}')
      'ce{'}' (<- '{s}')
      'ch' (<- '{esh}')
      'chr' (<- '{k}{r}')
      'd' 'dd' (<- '{d}')
      'dg' (<- '{d}{ezh}')
      'f' 'ff' (<- '{f}')
      'g' ((test (soft_vowels or '{'}') <- '{ezh}' delete_soft_e) or <- '{g}')
      'gu' ((test (soft_vowels or '{'}') <- '{g}') or <- '{g}{y}')
      'gue' (<- '{g}')
      'h' ()
      'j' (<- '{ezh}')
      'k' ()
      'l' 'll' 'l{'}ye' (<- '{l}')
      'l{'}l' (<- '{l}{l}')
      'lyi' (<- '{j}{i}')
      'm' 'mm' (<- '{m}')
      'n' 'nn' (<- '{n}')
      'gn' (<- '{gn}')
      'p' 'pp' (<- '{p}')
      'qu' 'cqu' (<- '{k}')
      'r' 'rr' (<- '{r}')
      's' ((test vowels reverse ('s' try '{long}' ipa_oral_vowels) <- '{z}') or <- '{s}')
      'ss' (<- '{s}')
      'sc' ((test soft_vowels <- '{s}') or <- '{s}{k}')
      't' 'tt' (<- '{t}')
      'tch' (<- '{t}{esh}')
      'th' (<- '{eth}')
      'v' ()
      'w' ()
      'x' (<- '{z}')
      'z' (<- '{z}')
      '{'}' (delete)
    )
)


define vowel_phoneme as (
  [substring] among (

    // Plain vowels
    'a' '{a`}' (<- '{a}')
    'e' '{e'}' '{e`}' 'ei' (<- '{eps}')
    '{e'}e' (<- '{e}')
    'i' ((test vowels_without_y reverse ('i' ipa_consonants) <- '{j}') or <- '{i}')
    '{i"}' 'y' ((test vowels_without_y <- '{j}') or <- '{i}')
    'o' (<- '{openo}')
    'u' '{u`}' '{u"}' (<- '{y}')

    // Long vowels
    '{a^}' (<- '{scripta}{long}')
    '{e^}' (<- '{e}{i}')
    '{i^}' '{y^}' (<- '{i}{long}')
    '{o^}' (<- '{o}{u}')
    '{u^}' (<- '{y}{long}')

    // Nasal (& exceptions)
    'an' ((test oralize <- '{a}{n}') or <- '{scripta~}')
    'ain' 'ein' ((test oralize <- '{eps}{n}') or <- '{eps~}')
    'aine' 'eine' 'ainne' 'einne' (<- '{eps}{n}')
    'ainem' 'einem' (<- '{eps}{n}{m}')
    'ent' 'ant' (
      (
        test (vowels or 'ch' or 'r')
        <- '{scripta~}{t}'
        test try (
          [ 'e' ]
          ('m' or 'p')
          delete
        )
      ) 
      or <- '{scripta~}'
    )
    'en' '{e"}n' ((test oralize or 'ne' or 'n' ] <- '{eps}{n}') or <- '{scripta~}')
    'em' '{e"}m' ((test oralize or 'm' ] <- '{eps}{m}') or <- '{scripta~}')
    'in' '{i^}n' (<- '{e~}')
    'inn' (
      <- '{I}{n}'
      test try (
        [ 'e' ]
        ('m' or 'p' or ('t' e_any))
        delete
      )
    )
    '{o^}n' (<- '{o~}')
    'on' ((test oralize <- '{openo}{n}') or <- '{o~}')
    'om' ((test oralize <- '{openo}{m}') or <- '{o~}')
    'onn' (<- '{o}{n}')
    'onnem' (<- '{o}{n}{m}')
    'omm' (<- '{o}{m}')
    'un' 'um' (<- '{o`~}')
    'unn' (<- '{u}{n}')
    'umm' (<- '{u}{m}')

    // Diphthongs
    'ai' 'a{i^}' (<- '{e}{i}')
    'au' 'a{u^}' (<- '{o}{u}')
    'eau' (<- '{o}{u}')
    'ui' (<- '{u}{i}')
    'ueu' (<- '{w}{oe}')
    'u{i^}' (<- '{u}{i}{long}')
    'u{i^}n' (<- '{u}{e~}')
    'yi' (<- '{j}{i}')

    // Other combinations
    'ayi' (<- '{e}{long}{j}{i}')
    'e{i^}' (<- '{eps}{long}')
    'eu' (<- '{oe}')
    'e{u^}' (<- '{oe}{long}')
    'o{u^}' (<- '{u}{long}')
    'oeu' (<- '{oe}')
    'ou' (
      (
        reverse (
          'ou' 
          (ipa_consonants or (try '{long}' ipa_nasal_vowels) or atlimit)
        ) 
        test vowels 
        <- '{w}'
      )
      or <- '{u}'
    )
    '{o"}u' ((test vowels <- '{w}') or <- '{u}')

    // Soft L
    'aill' (<- '{scripta}{long}{j}' try (['{'}l'] <- '{j}'))
    'aill{'}' (<- '{scripta}{l}')
    'eill' (<- '{e}{j}')
    'eill{'}l' (<- '{e}{long}{j}{j}')
    'ill' ((reverse ('ill' try '{long}' ipa_vowels)  <- '{j}') or <- '{i}{j}')
    'ill{'}l' ((reverse ('ill{'}' try '{long}' ipa_vowels)  <- '{j}{j}') or <- '{i}{j}{j}')
  )
)

define word_final as (
    [substring] 
    atlimit
    among (
      'ai' 'ais' 'er'
        (<- '{e}')
      'aim'
        (<- '{eps~}')
      'aye'
        (<- '{e}{i}')
      'et' 'ets' '{e"}t' '{e"}ts'
        (<- '{eps}')
      'a{i^}' 'a{i^}s'
        (<- '{eps}{long}')
      'au' 'aus'
        (<- '{o}{u}')
      'aue'
      'aues'
      'aux'
      'eaux'
        (<- '{o}{u}{long}')
      'ieau'
        (<- '{j}{o}{u}')
      'ieaux'
        (<- '{j}{o}{u}{long}')
      'eux'
        (<- '{oe}{long}')
      'euse'
        (<- '{oe}{long}{z}')
      '{e'}e'
      '{e'}es'
        (<- '{e}') // TODO: long
      'ait'
      'aient'
      'aie'
      'aies'
        (<- '{e}{i}')
      'eyen'
      'a{i"}en'
        (<- '{e}{j}{eps~}')
      '{e'}s'
      'ez'
        (<- '{e}')
      '{e'}er'
        (<- '{e}{j}{e}')
      'o'
      'os'
        (<- '{o}')
      'oue'
        (<- '{u}{long}')
      '-ous'
        (<- '{u}')
      'ien'
      '{i"}en'
        (
          (
            reverse (('ien' or '{i"}en') ipa_consonants)
            <- '{y}{eps~}'
          )
          or <- '{i}{eps~}'
        )
      'inne'
      'innes'
        (<- '{I}{n}')
      'it'
      'id'
        (<- '{i}')
      'ue'
        (<- '{y}{long}')
      'ie'
      'ies'
      'is'
      'iz'
      'ix'
      'its'
      'ids'
        (<- '{i}{long}')
      'eue'
      'eues'
        (<- '{oe}{long}')
      'ye'
      'yes'
        (<- '{i}')
      'e'
      'es'
      (delete)
      'gue'
      'gues'
        (<- '{g}')
      'enner'
      'ennez'
        (<- '{eps}{n}{e}')
      'ment'
      'ments'
      'ement'
      'ements'
        (<- '{m}{scripta~}')
      'mente'
      'mentes'
      'emente'
      'ementes'
        (<- '{m}{scripta~}t')
      'ville'
      'villes'
        (<- '{v}{i}{l}')
      'b' 'c' 'd' 'g' 'h' 'j' 'm' 'n' 'p' 's' 't' 'v' 'w' 'x' 'y' 'z'
        (delete)
    )
)

define phoneme as ( 
    word_final
    or mid_word_exceptions
    or vowel_phoneme
    or consonant_phoneme
  )

define phonemize_word as (
    repeat pre_word
    exceptions 
    or 
    silent_nt
    try word_initial
    repeat phoneme
)

strings ( suffix )

define exceptions_with_hyphens as (
  backwards (
    [substring]
    among (
      '-t-i{'}'
      '-t-alle'
      '-ous'
      '-ieune'
      '-ieuni{e`}me'
    )
    -> suffix
  )
  setlimit goto suffix for phonemize_word_with_hyphens
  backwards (
    [substring]
    among (
      '-t-i{'}' (<- '{t}{i}')
      '-t-alle' (<- '{t}{a}{l}')
      '-ous' (<- '{u}')
      '-ieune' (<- '{j}{oe}{n}')
      '-ieuni{e`}me' (<- '{j}{oe}{n}{j}{eps}{m}')
    )
  )
  tolimit
)

define phonemize_word_with_hyphens as (
  exceptions_with_hyphens or
  repeat (
     setlimit ((goto '-') or tolimit) for phonemize_word
     goto '-'
     ['-'] <- ' '
  )
)

define phonemize as (
  do repeat (goto (not accepted_characters) [ next ] <- ' ')
  repeat (
    setlimit ((goto ' ') or tolimit) for (
      phonemize_word_with_hyphens
    )
    gopast ' '
  )
)

// TODO: clean input
