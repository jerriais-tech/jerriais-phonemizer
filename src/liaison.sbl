routines ( 
  liaison 
  liaison_set_phrases 
)

booleans (
  may_liaise
  must_liaise
)

define liaison as (
  [substring]
  atlimit
  among (
    'un' (<- '{o`~}{n}')
    '{e`}s' (<- '{eps}{z}')
    'les' (<- '{l}{eps}{z}')
    'des' (<- '{d}{eps}{z}')
    'en' (<- '{scripta~}{n}')

    'ous' (<- '{u}{z}')
    'mes' (<- '{m}{eps}{z}')
    'tes' (<- '{t}{eps}{z}')
    'ses' (<- '{s}{eps}{z}')
    'lus' (<- '{l}{y}{z}')
    'nos' (<- '{n}{o}{z}')
    'vos' (<- '{v}{o}{z}')
    'nouos' (<- '{n}{w}{o}{z}')
    'vouos' (<- '{v}{w}{o}{z}')

    'ch{'}t' (<- '{esh}{t}')
    'ches' (<- '{esh}{eps}{z}')

    'deux' (<- '{d}{oe}{z}')
    'trais' (<- '{t}{r}{e}{z}')
    'si{e^}x' (<- '{s}{j}{ei_long}{z}')
    'dgi{e^}x' (<- '{d}{ezh}{j}{ei_long}{z}')
    'v{i^}ngt' (<- '{v}{e~}{long}{t}')
    'sept' (<- '{s}{eps}{t}')
    'huit' (<- '{w}{i}{t}')
    'neuf' (<- '{n}{oe}{v}')
  )
)

define liaison_set_phrases as (
  [substring]
  among (
    'pus {a`} co' (<- '{p}{y}{z} {a} {k}{o}')
    'temps en temps' (<- '{t}{scripta~}{z} {scripta~} {t}{scripta~}')
    'd{'}temps en temps' (<- '{d}{t}{scripta~}{z} {scripta~} {t}{scripta~}')
    'pus en pus' (<- '{p}{y}{z} {scripta~} {p}{y}')
    'd{'}pus en pus' (<- '{d}{p}{y}{z} {scripta~} {p}{y}')
    'd{'}mains en mains' (<- '{d}{m}{eps~}{z} {scripta~} {m}{eps~}')
    'tout {a`} fait' (<- '{t}{u}{t} {a} {f}{ei}')
    'ch{'}est en tchi' (<- '{esh}{e}{t} {scripta~} {tch}{i}')
    'm{'}est avis' (<- '{m}{e}{t} {a}{v}{i}')
    'est avis' (<- '{e}{t} {a}{v}{i}')
    // TODO: bein - yes or no?
  )
)
