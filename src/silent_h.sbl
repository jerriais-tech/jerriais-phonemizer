routines ( silent_h )

define silent_h as (
  test ([ 'h' ])
  test (
    substring among (
      'habi'
      'h{a^}cou'
      'ha{i^}mpettes'
      'haleine'
      'halen{e'}e'
      'haoulouoge'
      'harmonium'
      'h{a^}sard'
      'h{a^}si'
      'hasias'
      'h{a^}s{i^}n'
      'hathias'
      'harias'
      'ha{u^}s{i^}n'
      'hav{'}thon'
      'hav{'}non'
      'h{e'}breu'
      'h{e'}las'
      'h{e'}li{e`}r'
      'h{e'}liotrope'
      'h{e'}lyi'
      'h{e'}morragie'
      'h{e`}rb'
      'h{e`}rch'
      'h{e'}r{e'}'
      'h{e`}rmi'
      'h{e'}rode'
      'h{e`}rs'
      'h{e'}si'
      'h{e'}thache'
      'h{e'}th{e`}que'
      'h{e'}thi'
      'h{e'}tho'
      'heunmeu'
      'heunmid'
      'heure'
      'he{u^}re'
      'he{u^}s'
      'heuth'
      'he{u^}th'
      'hie'
      'hi{e`}'
      'h{i^}ndou'
      'h{i^}nmeu'
      'hiouppe'
      'hippo'
      'hiron'
      'his'
      'h{i^}s'
      'h{i^}t'
      'hiv'
      'h{o^}lou'
      'homicide'
      'homm{'}thie'
      'honmage'
      'hommage'
      'honmasse'
      'honn{e^}te'
      'honor'
      'h{o^}pit'
      'horiz'
      'h{o^}rr'
      'hortic'
      'hospi'
      'h{o^}tel'
      'houa'
      'houe'
      'hou{e^}'
      'hou{e'}'
      'houi'
      'hou{i^}'
      'houo'
      'hou{o^}'
      'houp{'}s{e'}'
      'houyie'
      'hufer'
      'hum'
      'hus'
      'h{u^}s'
      'hy'
      'h{y^}'
        (delete)
      'heu'
      'heur'
      'honme'
      'homme'
      'honneu'
      'h{o^}te'
        (atlimit delete)
    )
  )
  or
  (
    test substring 
    among (
      'hue' 'hui' (['hu'] <- '{w}')
    )
  )
)
